# SpotiBase AI - FastAPI AI Server env example
# Copy to .env and fill in secrets. Never commit .env. Never hardcode tokens.

# LLM mode: mock | transformers | hf_api | cf_workers
AI_MODE=mock

# Local / HF (transformers / hf_api)
QWEN_MODEL=Qwen/Qwen2.5-3B-Instruct
# HF_TOKEN=  # secret via env only (hf_api)

# Cloudflare Workers AI (cf_workers). Secrets via env only, token never logged.
# Missing CF_ACCOUNT_ID/CF_AI_TOKEN -> mock fallback (never raises).
# 2 attempts: CF_TIMEOUT_S (default 2.5s) then 1.0s; retry 429/5xx/timeout only.
# CF_ACCOUNT_ID=
# CF_AI_TOKEN=
CF_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CF_TIMEOUT_S=2.5

# STT mode: mock | faster-whisper
STT_MODE=mock
STT_MODEL=small

AI_PORT=7860

# Shared cache with Spring Boot (optional; degrades to uncached if unreachable)
REDIS_URL=redis://localhost:6379/0
AI_CACHE_UNDERSTAND_TTL=300
AI_CACHE_STT_TTL=600
