# SpotiBase Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_DB=spotibase
POSTGRES_USER=spotibase
POSTGRES_PASSWORD=your_secure_postgres_password_here

# =============================================================================
# SUPABASE (Storage & Auth)
# =============================================================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Storage bucket names
SUPABASE_STORAGE_BUCKET=spotibase
SUPABASE_STORAGE_COVERS_PATH=covers
SUPABASE_STORAGE_AVATARS_PATH=avatars

# =============================================================================
# CLOUDFLARE R2 (Song Storage)
# =============================================================================
# Create an R2 bucket and API token at https://dash.cloudflare.com
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=spotibase-songs
R2_PUBLIC_URL=https://pub-xxx.r2.dev  # Optional: custom domain for public access
R2_SONGS_PATH=songs
R2_REGION=auto

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_32_char_minimum_secret_key_here
JWT_EXPIRATION=86400000           # 24 hours (ms) - matches application.yml default
JWT_REFRESH_EXPIRATION=2592000000 # 30 days (ms) - matches application.yml default

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# Use SendGrid, Mailgun, AWS SES, or your own SMTP server
# NOTE: the backend reads SMTP_* names (application.yml spring.mail.*)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key

# =============================================================================
# OPENAI (AI Recommendations)
# =============================================================================
OPENAI_API_KEY=sk-your_openai_api_key

# =============================================================================
# APPLICATION URLs
# =============================================================================
APP_BASE_URL=https://api.yourdomain.com
APP_FRONTEND_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,exp://your-expo-dev-url

# =============================================================================
# DOMAIN & SSL
# =============================================================================
DOMAIN=yourdomain.com

# =============================================================================
# OPTIONAL: REDIS (for caching, sessions, rate limiting)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password  # Optional

# =============================================================================
# OPTIONAL: MONITORING & LOGGING
# =============================================================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# LOG_LEVEL=INFO
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# =============================================================================
# OPTIONAL: SOCIAL LOGIN (Google, Apple)
# =============================================================================
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# APPLE_CLIENT_ID=your_apple_client_id  # REQUIRED for Apple Sign-In; Apple tokens are rejected when unset
# APPLE_TEAM_ID=your_apple_team_id
# APPLE_KEY_ID=your_apple_key_id
# APPLE_PRIVATE_KEY=your_apple_private_key

# =============================================================================
# OPTIONAL: PUSH NOTIFICATIONS (Expo/FCM/APNs)
# =============================================================================
# EXPO_PUSH_TOKEN=your_expo_push_token
# FCM_SERVER_KEY=your_fcm_server_key
# APNS_KEY_ID=your_apns_key_id
# APNS_TEAM_ID=your_apns_team_id
# APNS_PRIVATE_KEY=your_apns_private_key

# =============================================================================
# MOBILE APP (Expo)
# =============================================================================
EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# DEVELOPMENT OVERRIDES (only for local development)
# =============================================================================
# SPRING_PROFILES_ACTIVE=dev
# LOGGING_LEVEL_COM_SPOTIBASE=DEBUG
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=